# Optional: Upstash Redis for production (Vercel / Cloudflare-compatible serverless).
# Without these, votes are stored in .data/votes.json (works for local `next dev` / `next start`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL used by the /qr page (set after deploy).
# Example: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
