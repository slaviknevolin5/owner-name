# Public site URL used by the /qr page (set to your Workers/Pages URL after deploy).
# Example: https://olympiad-vote.your-subdomain.workers.dev
NEXT_PUBLIC_SITE_URL=

# Optional fallback: Upstash Redis (if not using Cloudflare KV binding OLYMPIAD_VOTES).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare API token for non-interactive wrangler deploy
# CLOUDFLARE_API_TOKEN=
